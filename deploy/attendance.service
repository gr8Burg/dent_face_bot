# systemd unit for the attendance service. Installed by deploy/setup-pi.sh, which replaces
# __USER__, __DIR__ and __UV__ with the real user, project directory and uv path.
[Unit]
Description=Attendance (Hikvision terminal -> Telegram)
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__DIR__
ExecStart=__UV__ run --frozen --no-dev attendance run
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
