# --- Terminal (found via SADP: DS-K1T343MWX, MAC 0c-cd-b4-68-f8-66) ---
HIK_HOST=192.168.31.218
HIK_PORT=80
HIK_USER=admin
HIK_PASSWORD=

# --- Work-time rules ---
# IANA time zone used for workdays and reports, e.g. Asia/Omsk, or Etc/GMT-6 for a fixed UTC+6 (sign is inverted in Etc/ names). Defaults to this machine's offset.
TIMEZONE=
# Scans before this local time count towards the previous workday (night shifts).
DAY_CUTOFF=04:00

# --- Storage / sync ---
DB_PATH=data/attendance.db
# How often to re-read the terminal's event log to fill gaps in the live stream.
RECONCILE_MINUTES=10
# How far back to import events on the very first start.
BACKFILL_DAYS=31

# --- Telegram (leave TELEGRAM_BOT_TOKEN empty to run the collector only) ---
TELEGRAM_BOT_TOKEN=
# Chats that receive scheduled reports (comma-separated; send /start to the bot to see your chat id).
TELEGRAM_REPORT_CHAT_IDS=
# Extra Telegram user ids allowed to use bot commands (report chats are always allowed).
TELEGRAM_ADMIN_IDS=
# Daily report time and which workday it covers: today | yesterday
DAILY_REPORT_TIME=20:00
DAILY_REPORT_FOR=today
# Monthly report for the previous month is sent on the 1st at this time.
MONTHLY_REPORT_TIME=09:00
# Send a message when an employee's first scan of the day arrives.
NOTIFY_ARRIVALS=false
